# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BROWSERLESS_API_KEY=

# DATABASE_PATH: Local SQLite file location (default: ./nexus.db). Overridden by TURSO_* when set.
DATABASE_PATH=./nexus.db

# GITHUB_TOKEN: Optional, raises GitHub API rate limits for repo analysis.
GITHUB_TOKEN=

# GEMINI_MODEL: Gemini model id used for all GenAI calls (default: gemini-3.7-flash).
GEMINI_MODEL=gemini-3.7-flash

# LINKEDIN_COOKIES_JSON: Optional JSON array of LinkedIn session cookies to enable live profile scraping.
LINKEDIN_COOKIES_JSON=

# CANDIDATE_EMAIL: Email used by the LinkedIn scout networking plan and xAPI handshake.
CANDIDATE_EMAIL=

# DOCKER_HOST: Optional Docker daemon endpoint override used by the hardware probe.
DOCKER_HOST=

# LOCAL_LLM_ENDPOINT: OpenAI-compatible local inference endpoint (e.g. Ollama).
# Setting this is what makes the app report an inference engine as configured; features
# that would otherwise decline to answer (interview scoring, synthesis) start working.
# Default when unset: http://localhost:11434/v1
LOCAL_LLM_ENDPOINT=

# LOCAL_LLM_MODEL_NAME: Model id requested from that endpoint.
# Default when unset: qwen2.5-coder:7b-instruct
LOCAL_LLM_MODEL_NAME=

# LOCAL_LLM_API_KEY: Optional bearer token, if your local endpoint requires one.
LOCAL_LLM_API_KEY=
